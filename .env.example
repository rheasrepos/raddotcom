# Copy to .env (gitignored) for local dev. On Vercel, set these in
# Project → Settings → Environment Variables and redeploy.
# Both are from Supabase → Project Settings → API. The anon key is PUBLIC by design.
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=

# Guestbook → Formspree form id (the part after formspree.io/f/). HOW TO §5c.
PUBLIC_FORMSPREE_ID=
